{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracegraph.dev/contracts/analysis-report.schema.json",
  "title": "tracegraph body-free analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "artifact_digest",
    "trace_id",
    "source_kind",
    "status",
    "causal_fidelity",
    "links_preserved",
    "step_count",
    "error_count",
    "primary_failures",
    "propagated_failures",
    "patterns",
    "metrics",
    "decision_evidence",
    "comparison",
    "warnings",
    "privacy_profile"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "tracegraph.analysis"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "trace_id": {"type": "string"},
    "source_kind": {"type": "string"},
    "status": {"enum": ["ok", "error", "unset"]},
    "causal_fidelity": {"enum": ["declared_dag", "parent_only", "legacy_unknown"]},
    "links_preserved": {"type": ["boolean", "null"]},
    "step_count": {"type": "integer", "minimum": 0},
    "error_count": {"type": "integer", "minimum": 0},
    "primary_failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "propagated_failures": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "patterns": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "decision_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/decisionEvidence"}
    },
    "comparison": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/comparison"}]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "privacy_profile": {"const": "safe-v1"}
  },
  "$defs": {
    "decisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "artifact_digest", "graph_generation", "verdict"],
      "properties": {
        "source": {"const": "toolgraph_preflight"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "graph_generation": {"type": "integer", "minimum": 0},
        "verdict": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "seq", "name", "kind", "status"],
      "properties": {
        "step_id": {"type": "string"},
        "seq": {"type": "integer"},
        "name": {"type": ["string", "null"]},
        "kind": {"type": "string"},
        "status": {"enum": ["ok", "error", "unset"]}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "cause", "origin"],
      "properties": {
        "effect": {"type": "string"},
        "cause": {"type": "string"},
        "origin": {"type": ["string", "null"]}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "causal_steps", "causal_edges"],
      "properties": {
        "step": {"$ref": "#/$defs/step"},
        "causal_steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "causal_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "pattern_version", "step_ids", "labels"],
      "properties": {
        "pattern_id": {"type": "string"},
        "pattern_version": {"type": "integer", "minimum": 1},
        "step_ids": {"type": "array", "items": {"type": "string"}},
        "labels": {"type": "array", "items": {"type": ["string", "null"]}}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "name", "label", "score"],
      "properties": {
        "step_id": {"type": "string"},
        "name": {"type": "string"},
        "label": {"type": ["string", "null"]},
        "score": {"type": ["number", "null"]}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_duration_ms",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "total_cost",
        "cost_currency",
        "evaluations"
      ],
      "properties": {
        "wall_duration_ms": {"type": ["number", "null"]},
        "prompt_tokens": {"type": ["integer", "null"]},
        "completion_tokens": {"type": ["integer", "null"]},
        "total_tokens": {"type": ["integer", "null"]},
        "total_cost": {"type": ["string", "null"]},
        "cost_currency": {"type": ["string", "null"]},
        "evaluations": {"type": "array", "items": {"$ref": "#/$defs/evaluation"}}
      }
    },
    "behaviorChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_step_key",
        "name",
        "before",
        "after"
      ],
      "properties": {
        "logical_step_key": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "before": {
          "enum": [
            "ok",
            "error",
            "unset",
            null
          ]
        },
        "after": {
          "enum": [
            "ok",
            "error",
            "unset",
            null
          ]
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_digest",
        "topology_identical",
        "topology_changes",
        "behavior_changes",
        "pattern_count_deltas",
        "metric_deltas"
      ],
      "properties": {
        "baseline_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "topology_identical": {
          "type": "boolean"
        },
        "topology_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "behavior_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/behaviorChange"
          }
        },
        "pattern_count_deltas": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "metric_deltas": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
